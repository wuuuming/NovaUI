// Stack: a container whose children are placed by `left` / `top` / `right` / `bottom`, each of
// which takes its element out of the flow (absolute), so children can overlap.
style Text { type: body; }
style badge { width: 12; height: 12; radius: 6; bg: accent; }

Row #root { width: 100%; height: 100%; bg: solid-base; padding: 24; gap: 32; align: center;
  Stack #avatar { width: 64; height: 64; on-click: status;
    Box { left: 0; top: 0; width: 64; height: 64; radius: 32; bg: #3A3A3A; align: center; justify: center;
      Icon Person { icon-size: 32; fg: text-secondary; } }
    Box #dot { right: 0; bottom: 0; width: 20; height: 20; radius: 10; bg: #6CCB5F; border: 3 solid-base; }
  }
  Stack { width: 240; height: 120; radius: 8; clip: true; bg: #3060C0;
    Box { left: 120; top: -40; width: 160; height: 160; radius: 80; bg: #C0A030; }
    Column { left: 0; right: 0; bottom: 0; padding: 8, 12; bg: #A0000000;
      Text "A caption over a picture"; }
  }
  Stack { width: 200; height: 120; radius: 8; bg: card-fill; border: 1 stroke-surface;
    Text "A badge in each corner" { left: 16; top: 48; type: caption; fg: text-secondary; }
    Box .badge { left: 6; top: 6; } Box .badge { right: 6; top: 6; }
    Box .badge { left: 6; bottom: 6; } Box .badge { right: 6; bottom: 6; }
  }
}
