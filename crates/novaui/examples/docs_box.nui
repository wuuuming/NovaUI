// Box: a plain container. Every element takes the visual properties shown here.
style tile { width: 112; height: 80; }
style Text { type: caption; fg: text-secondary; }

Row #root { width: 100%; height: 100%; bg: solid-base; padding: 24; gap: 16; align: start;
  Column { gap: 8; Box .tile { bg: #3A3A3A; } Text "bg"; }
  Column { gap: 8; Box .tile { bg: card-fill; radius: 8; border: 1 stroke-surface; } Text "radius, border"; }
  Column { gap: 8; Box .tile { bg: #2B2B2B; radius: 8; shadow: shadow-dialog; } Text "shadow"; }
  Column { gap: 8; Box .tile #faded { bg: accent; radius: 8; opacity: 0.5; on-click: fade; } Text "opacity (click it)"; }
  Column { gap: 8;
    Box .tile { radius: 8; clip: true;
      Row { width: 100%; height: 100%; align: stretch;
        Box { grow: 1; bg: #3060C0; } Box { grow: 1; bg: #C0A030; } Box { grow: 1; bg: #30A060; } }
      Box { left: 12; top: 12; right: 12; bottom: 12; radius: 6; material: acrylic; border: 1 stroke-flyout; }
    }
    Text "material: acrylic";
  }
  // Filled from Rust.
  Column #mine { gap: 8; }
}
