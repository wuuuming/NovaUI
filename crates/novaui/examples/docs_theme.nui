// Theming: bare names (`accent`, `card-fill`, `body`, `radius-control`) are tokens, resolved
// through the installed `Theme` when the sheet is built. A sheet's own `token` lines come first.
token brand = #FF8A3D;

component Card(title) {
  Column { width: 300; padding: 16; gap: 12; radius: radius-overlay; bg: card-fill; border: 1 stroke-card;
    Text { text: $title; type: subtitle; fg: text-primary; }
    Text "Tokens from the installed theme." { type: body; fg: text-secondary; }
    Row { gap: 8;
      Button { height: control-height; padding: 0, 12; radius: radius-control; bg: accent;
        Text "Accent" { fg: black; } }
      Button { height: control-height; padding: 0, 12; radius: radius-control; bg: control-fill; border: 1 stroke-control;
        Text "Control" { fg: text-primary; } }
      Box { size: 32; radius: radius-control; bg: brand; }
    }
  }
}

Row #root { width: 100%; height: 100%; bg: solid-base; padding: 24; gap: 24; align: start; }
