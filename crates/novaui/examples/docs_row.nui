// Row: children left to right, centred across by default.
style row { grow: 1; height: 44; padding: 0, 10; gap: 8; radius: 6; bg: card-fill; border: 1 stroke-surface; }
style chip { width: 64; height: 24; radius: 4; bg: #6660CDFF; }
style Text { type: caption; fg: text-secondary; width: 120; shrink: 0; }

Column #root { width: 100%; height: 100%; bg: solid-base; padding: 24; gap: 10;
  Row { gap: 12; Text "gap: 8"; Row .row { Box .chip; Box .chip; Box .chip; } }
  Row { gap: 12; Text "justify: center"; Row .row { justify: center; Box .chip; Box .chip; Box .chip; } }
  Row { gap: 12; Text "justify: between"; Row .row { justify: between; Box .chip; Box .chip; Box .chip; } }
  Row { gap: 12; Text "grow: 1 / 2 / 0"; Row .row { Box .chip { grow: 1; } Box .chip { grow: 2; } Box .chip; } }
  // Filled from Rust.
  Row { gap: 12; Text "wrap-children"; Row .row #wrap { height: auto; padding: 8, 10; wrap-children: true; } }
}
